const { createApp } = Vue;

createApp({
    data() {
        return {
            // Controle de telas
            carrinhoAberto: false,
            pedidoSucesso: false,

            // Controle do Menu Flutuante Customizado de Bairros (Estilo iFood)
            abrirDropdownBairro: false,
            buscaBairro: '',
            bairroSelecionado: '',
            taxaEntrega: 0.00,

            linkWhatsPendente: '',

            // Rascunho do produto ATUAL sendo montado
            tamanhoSelecionado: null,
            recheiosSelecionados: [],

            // Array que guarda todos os copos adicionados ao carrinho
            itensNoCarrinho: [],

            // Dados do Cliente
            nomeCliente: '',
            telefoneCliente: '',
            enderecoRua: '',
            enderecoNumero: '',
            enderecoComplemento: '',
            formaPagamento: '',
            precisaTroco: null,
            valorTroco: '',

            // Configurações lidas do HTML após o mount (evita DOM access em computed)
            nutellaGratisAtiva: false,
            whatsappVendedor: '',
            lojaAbertaAtiva: true,

            // Controle do modal de confirmação pós-adição
            modalAdicionadoAberto: false,
            ultimoItemAdicionado: null,

            // Controle do toast de aviso (ex: limite de recheios)
            toastMensagem: '',
            toastTimer: null,

            ingredientesDisponiveis: []
        }
    },
    mounted() {
        // Lê as configurações dos inputs hidden com segurança após o DOM estar pronto
        this.nutellaGratisAtiva = document.getElementById('nutella_gratis_config')?.value === 'true';
        this.whatsappVendedor = document.getElementById('whatsapp_vendedor_config')?.value || '';
        this.lojaAbertaAtiva = document.getElementById('loja_aberta_config')?.value !== 'false';

        setInterval(async () => {
            try {
                const response = await fetch('/admin/api/status-loja');
                if (response.ok) {
                    const data = await response.json();

                    // 1. Atualiza se a loja está aberta
                    this.lojaAbertaAtiva = data.loja_aberta;

                    // 2. Atualiza se a nutella é grátis
                    this.nutellaGratisAtiva = data.nutella_gratis;

                    // 3. Atualiza os ingredientes do cardápio em tempo real
                    // Nota: Para isso funcionar perfeitamente, a sua lista de recheios exibida no HTML do cliente 
                    // deve usar uma diretiva v-if baseada nos dados atualizados se você estiver renderizando via Vue,
                    // ou você pode guardar 'data.ingredientes_disponiveis' em uma variável do data() para controlar o HTML.
                }
            } catch (err) {
                console.error("Erro automático ao checar status da loja:", err);
            }
        }, 5000);
    },
    computed: {
        labelTamanho() {
            if (this.tamanhoSelecionado === 22) return "350ML";
            if (this.tamanhoSelecionado === 27) return "500ML";
            if (this.tamanhoSelecionado === 37) return "1L";
            return "";
        },
        adicionalNutella() {
            if (this.recheiosSelecionados.includes("Nutella") && !this.nutellaGratisAtiva) {
                return 3.00;
            }
            return 0.00;
        },
        // Calcula o valor do copo que está sendo montado na tela agora
        precoItemAtual() {
            if (!this.tamanhoSelecionado) return 0.00;
            return this.tamanhoSelecionado + this.adicionalNutella;
        },
        // Calcula a soma de TODOS os copos que já estão no carrinho
        subtotalItens() {
            return this.itensNoCarrinho.reduce((soma, item) => soma + item.precoTotal, 0);
        },
        totalCarrinhoComEntrega() {
            return this.subtotalItens + this.taxaEntrega;
        },
        // Soma os itens + a taxa de entrega única
        totalPedido() {
            return this.subtotalItens + this.precoItemAtual + this.taxaEntrega;
        },
        totalFormatado() {
            return this.totalPedido.toFixed(2).replace('.', ',');
        }
    },
    methods: {
        // Exibe um toast de aviso no topo da tela por alguns segundos
        mostrarToast(mensagem, duracao = 3000) {
            if (this.toastTimer) clearTimeout(this.toastTimer);
            this.toastMensagem = mensagem;
            this.toastTimer = setTimeout(() => {
                this.toastMensagem = '';
            }, duracao);
        },

        validarLimite() {
            if (this.recheiosSelecionados.length > 3) {
                this.recheiosSelecionados.pop();
                this.mostrarToast('Máximo de 3 recheios por pote! 🍿');
            }
        },
        toggleDropdownBairro() {
            this.abrirDropdownBairro = !this.abrirDropdownBairro;
            if (this.abrirDropdownBairro) {
                this.buscaBairro = '';
                this.$nextTick(() => {
                    this.$refs.inputBuscaBairro?.focus();
                });
            }
        },
        filtrarBairro(nomeBairro) {
            if (!this.buscaBairro) return true;
            return nomeBairro.toLowerCase().includes(this.buscaBairro.toLowerCase());
        },
        clicarNoBairro(bairro, taxa) {
            this.bairroSelecionado = bairro;
            this.taxaEntrega = parseFloat(taxa);
            this.abrirDropdownBairro = false;
        },

        // Pega o copo atual e joga no carrinho, abrindo o modal de confirmação
        adicionarAoCarrinho() {
            if (!this.tamanhoSelecionado) {
                this.mostrarToast('Por favor, escolha o tamanho do seu pote primeiro! 🍿');
                return;
            }

            if (this.recheiosSelecionados.length === 0) {
                this.mostrarToast('Selecione pelo menos 1 recheio para montar seu pote! 😊');
                return;
            }

            // Cria uma cópia do copo atual montado
            const novoItem = {
                id: Date.now(),
                tamanhoLabel: this.labelTamanho,
                recheios: [...this.recheiosSelecionados],
                adicionalNutella: this.adicionalNutella,
                precoTotal: this.precoItemAtual
            };

            this.itensNoCarrinho.push(novoItem);

            // Guarda referência do item para exibir no modal
            this.ultimoItemAdicionado = novoItem;
            this.modalAdicionadoAberto = true;

            // Reseta a montagem para o cliente poder escolher outro
            this.recheiosSelecionados = [];
            this.tamanhoSelecionado = null;
        },

        // Fecha o modal de confirmação e deixa o cliente montar mais
        continuarAdicionando() {
            this.modalAdicionadoAberto = false;
            this.ultimoItemAdicionado = null;
            // Rola suavemente de volta ao topo para montar outro copo
            window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        // Fecha o modal de confirmação e abre o carrinho
        irParaCarrinhoDoModal() {
            this.modalAdicionadoAberto = false;
            this.ultimoItemAdicionado = null;
            this.carrinhoAberto = true;
        },

        // Permite o cliente tirar um item do carrinho
        removerItemCarrinho(id) {
            this.itensNoCarrinho = this.itensNoCarrinho.filter(item => item.id !== id);
        },

        irParaO_Carrinho() {
            if (this.itensNoCarrinho.length === 0) {
                this.mostrarToast('Seu carrinho está vazio! Monte um pote primeiro. 🛒');
                return;
            }
            this.carrinhoAberto = true;
        },
        voltarParaO_Cardapio() {
            this.carrinhoAberto = false;
        },
        irParaO_Checkout() {
            this.carrinhoAberto = false;
            setTimeout(() => {
                const checkoutSection = document.getElementById('checkout');
                if (checkoutSection) {
                    checkoutSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 180);
        },
        irParaLinkWhatsApp() {
            if (this.linkWhatsPendente) {
                window.location.href = this.linkWhatsPendente;
            }
        },
        async enviarPedido() {
            if (!this.lojaAbertaAtiva) {
                this.mostrarToast('Desculpe, a loja fechou e não está mais aceitando pedidos hoje. 🛑');
                return;
            }
            if (this.itensNoCarrinho.length === 0) {
                this.mostrarToast('Adicione pelo menos um produto ao carrinho antes de finalizar.');
                return;
            }
            if (!this.nomeCliente.trim()) {
                this.mostrarToast('Por favor, digite seu nome completo.');
                return;
            }
            if (!this.telefoneCliente.trim()) {
                this.mostrarToast('Por favor, informe seu telefone/WhatsApp.');
                return;
            }
            if (!this.bairroSelecionado) {
                this.mostrarToast('Por favor, selecione seu bairro de entrega.');
                return;
            }
            if (!this.enderecoRua.trim()) {
                this.mostrarToast('Por favor, informe o nome da sua rua.');
                return;
            }
            if (!this.enderecoNumero.trim()) {
                this.mostrarToast('Por favor, informe o número da sua residência (ou coloque S/N).');
                return;
            }
            if (!this.formaPagamento) {
                this.mostrarToast('Por favor, selecione uma forma de pagamento.');
                return;
            }

            let textoFormaPagamento = '';
            if (this.formaPagamento === 'dinheiro') {
                if (this.precisaTroco === null) {
                    this.mostrarToast('Por favor, informe se precisa de troco.');
                    return;
                }
                if (this.precisaTroco === 'sim' && !this.valorTroco.trim()) {
                    this.mostrarToast('Por favor, informe o valor para o troco.');
                    return;
                }
                textoFormaPagamento = this.precisaTroco === 'sim'
                    ? `Dinheiro 💵 (Troco para R$ ${this.valorTroco})`
                    : 'Dinheiro 💵 (Não precisa de troco)';
            } else {
                const pagamentosMap = {
                    'pix': 'Pix ⚡',
                    'credito': 'Cartão de Crédito 💳',
                    'debito': 'Cartão de Débito 💳'
                };
                textoFormaPagamento = pagamentosMap[this.formaPagamento];
            }

            let enderecoFinalParaO_Python = `${this.enderecoRua.trim()}, Nº ${this.enderecoNumero.trim()}`;
            if (this.enderecoComplemento.trim()) {
                enderecoFinalParaO_Python += ` - ${this.enderecoComplemento.trim()}`;
            }

            // Formatação do texto de múltiplos itens para o WhatsApp
            let itensTextoWhatsApp = "";
            this.itensNoCarrinho.forEach((item, index) => {
                itensTextoWhatsApp += `🍿 *Pote #${index + 1} (${item.tamanhoLabel})*\n`;
                itensTextoWhatsApp += `• Recheios: ${item.recheios.join(', ')}\n`;
                if (item.adicionalNutella > 0) {
                    itensTextoWhatsApp += `• Adicional Nutella: R$ ${item.adicionalNutella.toFixed(2).replace('.', ',')}\n`;
                }
                itensTextoWhatsApp += `• Valor do Pote: R$ ${item.precoTotal.toFixed(2).replace('.', ',')}\n\n`;
            });

            const textoWhatsApp =
                `🍫 *NOVO PEDIDO - DOCERIA DIVINO RECHEIO* 🍫\n\n` +
                `👤 *CLIENTE:*\n` +
                `• *Nome:* ${this.nomeCliente.trim()}\n` +
                `• *Telefone:* ${this.telefoneCliente.trim()}\n` +
                `• *Endereço:* ${enderecoFinalParaO_Python}\n` +
                `• *Bairro:* ${this.bairroSelecionado}\n\n` +
                `🛒 *PRODUTOS PEDIDOS:*\n${itensTextoWhatsApp}` +
                `💰 *PAGAMENTO & ENTREGA:*\n` +
                `• *Forma de Pagamento:* ${textoFormaPagamento}\n` +
                `• *Taxa de Entrega:* R$ ${this.taxaEntrega.toFixed(2).replace('.', ',')}\n` +
                `• *Total Geral:* R$ ${this.totalFormatado}\n\n` +
                `_Pedido enviado do cardápio digital._`;

            this.linkWhatsPendente = this.whatsappVendedor
                ? `https://api.whatsapp.com/send?phone=${this.whatsappVendedor}&text=${encodeURIComponent(textoWhatsApp)}`
                : `https://api.whatsapp.com/send?text=${encodeURIComponent(textoWhatsApp)}`;

            this.pedidoSucesso = true;

            // Formatação para o backend do admin
            const nomesTamanhosUnificados = this.itensNoCarrinho.map(i => i.tamanhoLabel).join(' + ');
            const recheiosUnificadosArray = this.itensNoCarrinho.map(i => `${i.tamanhoLabel}(${i.recheios.join(', ')})`);
            const totalNutellaGeral = this.itensNoCarrinho.reduce((s, i) => s + i.adicionalNutella, 0);

            const payload = {
                nome: this.nomeCliente.trim(),
                telefone: this.telefoneCliente.trim(),
                endereco: enderecoFinalParaO_Python,
                bairro: this.bairroSelecionado,
                tamanho: nomesTamanhosUnificados,
                recheios: recheiosUnificadosArray,
                adicional_nutella: totalNutellaGeral,
                forma_pagamento: textoFormaPagamento,
                taxa_entrega: this.taxaEntrega,
                total: this.totalPedido
            };

            try {
                await fetch('/admin/pedidos/novo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            } catch (err) {
                console.error("Erro interno ao tentar registrar pedido no painel administrador:", err);
            }
        }
    }
}).mount('#app');
</file>

<file path="templates/admin.html">
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Controle - Divino Recheio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght=300;400;500;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        divinoPink: {
                            light: '#F8E7EE',
                            medium: '#F383A8',
                            DEFAULT: '#D4376E',
                            dark: '#7D163B',
                        },
                        divinoGold: {
                            light: '#FFFBEB',
                            DEFAULT: '#D97706',
                            dark: '#78350F'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Outfit', sans-serif !important;
        }
    </style>
</head>

<body class="bg-pink-100/60 text-stone-800 min-h-screen pb-20">

    <div class="max-w-6xl mx-auto px-4 pt-8">

        <header
            class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80 flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-4">
                <div
                    class="w-16 h-16 bg-white rounded-full flex items-center justify-center p-1 shadow-md border-2 border-pink-100">
                    <img src="/static/logo.png" alt="Logo Doceria Divino Recheio"
                        class="w-full h-full object-contain rounded-full">
                </div>
                <div>
                    <h1 class="text-2xl font-black text-divinoPink-dark leading-tight">Painel da Cozinha</h1>
                    <p class="text-xs text-stone-400 font-medium">Doceria Divino Recheio — Gestão do Delivery</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="/" target="_blank"
                    class="text-sm bg-pink-50 text-divinoPink border border-pink-100 px-5 py-2.5 rounded-2xl font-bold hover:bg-divinoPink hover:text-white transition duration-200 shadow-sm">
                    Ver Cardápio ↗
                </a>
            </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-5 space-y-6">

                <form action="/admin/salvar" method="POST" id="form-principal" class="space-y-6">

                    <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80">
                        <h2 class="text-lg font-black text-stone-800 flex items-center gap-2 mb-4">
                            <span>⚙️</span> Configurações Gerais
                        </h2>

                        <div class="space-y-4">
                            <div>
                                <label
                                    class="text-xs font-bold text-stone-500 uppercase tracking-wider block mb-1.5">WhatsApp
                                    do Vendedor (Recebe os Pedidos)</label>
                                <input type="text" name="whatsapp_vendedor" value="{{ config.whatsapp_vendedor }}"
                                    placeholder="Ex: 24998217201"
                                    class="w-full p-3 border border-stone-200 rounded-xl text-sm font-semibold focus:outline-divinoPink bg-stone-50/50">
                                <span class="text-[10px] text-stone-400 block mt-1">Insira com DDD. O sistema formatará
                                    automatically.</span>
                            </div>

                            <div
                                class="flex justify-between items-center p-4 bg-pink-50 rounded-2xl border border-pink-200 mt-2">
                                <div>
                                    <span class="font-bold text-pink-950 text-sm block">Nutella Grátis hoje? 🍫</span>
                                    <span class="text-[10px] text-pink-800 font-medium">Zera o acréscimo de R$ 3,00 de
                                        Nutella em todos os potes</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer select-none">
                                    <input type="checkbox" name="nutella_gratis" value="true" class="sr-only peer" {% if
                                        config.nutella_gratis %}checked{% endif %}>
                                    <div
                                        class="w-11 h-6 bg-stone-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500">
                                    </div>
                                </label>
                            </div>

                            <div
                                class="flex justify-between items-center p-4 bg-pink-50 rounded-2xl border border-pink-200 mt-2">
                                <div>
                                    <span class="font-bold text-pink-950 text-sm block">Status da Loja: Aberta?
                                        🏪</span>
                                    <span class="text-[10px] text-pink-800 font-medium">Se desativado, o cardápio do
                                        cliente bloqueia novos pedidos automaticamente.</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer select-none">
                                    <input type="checkbox" name="loja_aberta" value="true" class="sr-only peer" {% if
                                        config.loja_aberta %}checked{% endif %}>
                                    <div
                                        class="w-11 h-6 bg-stone-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-600">
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80">
                        <div class="mb-4">
                            <h2 class="text-lg font-black text-stone-800 flex items-center gap-2">
                                <span>🍫</span> Ingredientes Disponíveis
                            </h2>
                            <p class="text-xs text-stone-400 mt-0.5">Desative recheios indisponíveis para ocultá-los no
                                cardápio.</p>
                        </div>

                        <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
                            {% for nome, dados in ingredientes.items() %}
                            <div
                                class="flex justify-between items-center p-3 bg-stone-50/70 hover:bg-stone-50 rounded-xl border border-stone-100 transition">
                                <span class="font-bold text-pink-700 text-sm flex items-center gap-2">
                                    <span class="text-xs text-pink-400">💕</span> {{ nome }}
                                </span>
                                <label class="relative inline-flex items-center cursor-pointer select-none">
                                    <input type="checkbox" name="ingrediente_{{ nome }}" value="true"
                                        class="sr-only peer" {% if dados.disponivel %}checked{% endif %}>
                                    <div
                                        class="w-11 h-6 bg-stone-200 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-pink-500">
                                    </div>
                                </label>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80">
                        <h2 class="text-sm font-black text-pink-700 mb-1 flex items-center gap-1.5">
                            <span>➕</span> Adicionar Novo Recheio
                        </h2>
                        <p class="text-[11px] text-stone-400 mb-3">Teve um recheio novo hoje? Insira abaixo:</p>
                        <div class="flex flex-row items-stretch gap-2 w-full">
                            <input type="text" name="novo_nome" form="form-novo-ingrediente"
                                placeholder="Ex: Ninho com Nutella" required
                                class="flex-1 p-3 border border-stone-200 bg-stone-50 font-medium rounded-xl text-xs focus:outline-divinoPink">
                            <button type="submit" form="form-novo-ingrediente"
                                class="bg-pink-500 hover:bg-pink-600 text-white font-bold px-5 rounded-xl text-xs transition duration-200 shadow-sm cursor-pointer flex items-center justify-center shrink-0">
                                Criar
                            </button>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80">
                        <div class="mb-4">
                            <h2 class="text-lg font-black text-stone-800 flex items-center gap-2">
                                <span>🛵</span> Taxas de Entrega por Bairro
                            </h2>
                            <p class="text-xs text-stone-400 mt-0.5">Edite o valor cobrado para cada bairro.</p>
                        </div>
                        <div class="bg-amber-50 p-3 rounded-xl border border-amber-200 mb-4 flex flex-col gap-2">
                            <div>
                                <span class="text-xs font-bold text-amber-950 block">⚡ Gestão de Taxas em Lote</span>
                                <span class="text-[10px] text-amber-800">Defina um teto promocional ou retorne aos
                                    valores padrão do cardápio.</span>
                            </div>
                            <div class="flex gap-2">
                                <input type="number" step="0.50" id="taxa_promocional_input" placeholder="Ex: 7.00"
                                    class="w-full p-2 border border-amber-300 bg-white font-bold rounded-lg text-xs outline-none text-right">
                                <button type="button" onclick="aplicarTaxaGlobal()"
                                    class="bg-amber-600 hover:bg-amber-700 text-white font-black px-3 rounded-lg text-xs transition duration-200 shrink-0 cursor-pointer">
                                    Limitar
                                </button>
                                <button type="button" onclick="resetarTaxasPADRAO()"
                                    class="bg-stone-600 hover:bg-stone-700 text-white font-black px-3 rounded-lg text-xs transition duration-200 shrink-0 cursor-pointer">
                                    Resetar 🔄
                                </button>
                            </div>
                        </div>

                        <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
                            {% for bairro, taxa in bairros.items() %}
                            <div
                                class="flex items-center justify-between p-2.5 bg-stone-50 rounded-xl border border-stone-100 gap-4">
                                <span class="font-semibold text-stone-700 text-xs truncate flex-1">{{ bairro }}</span>
                                <div
                                    class="flex items-center gap-1 bg-white px-2 py-1 rounded-lg border border-stone-200 w-24">
                                    <span class="text-[10px] text-stone-400 font-bold">R$</span>
                                    <input type="number" step="0.10" name="taxa_{{ bairro }}"
                                        value="{{ taxa | round(2) }}"
                                        class="w-full text-xs font-bold text-stone-800 outline-none text-right">
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-pink-300 hover:bg-pink-400 text-pink-800 font-black py-4 rounded-2xl shadow-md transition duration-200 transform active:scale-[0.99] border-b-4 border-pink-400 tracking-wide text-base cursor-pointer flex items-center justify-center gap-2">
                        💾 Salvar Todas as Configurações
                    </button>

                </form>

                <form action="/admin/novo-ingrediente" method="POST" id="form-novo-ingrediente" class="hidden"></form>

            </div>

            <div class="lg:col-span-7 space-y-6">

                <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-stone-200/80 min-h-[500px]">
                    <div class="border-b border-stone-100 pb-4 mb-6 flex justify-between items-center">
                        <div>
                            <h2 class="text-xl font-black text-stone-800 flex items-center gap-2">
                                <span>📦</span> Pedidos Ativos
                            </h2>
                            <p class="text-xs text-stone-400 mt-0.5">Acompanhe e notifique os seus clientes sobre o
                                andamento dos pedidos.</p>
                        </div>
                        <span class="bg-pink-100 text-divinoPink text-xs font-bold px-3 py-1 rounded-full">
                            {{ pedidos|rejectattr('status', 'equalto', 'Concluído')|rejectattr('status', 'equalto',
                            'Cancelado')|list|length }} Ativo(s)
                        </span>
                    </div>

                    <div class="space-y-6">
                        {% set pedidos_ativos = pedidos|rejectattr('status', 'equalto',
                        'Concluído')|rejectattr('status', 'equalto', 'Cancelado')|list %}
                        {% if not pedidos_ativos %}
                        <div class="text-center py-16 px-4">
                            <span class="text-5xl block mb-3">🍿</span>
                            <h3 class="font-extrabold text-stone-700 text-lg">Nenhum pedido ativo no momento</h3>
                            <p class="text-stone-400 text-xs mt-1">Os pedidos novos aparecerão aqui assim que os
                                clientes finalizarem a compra.</p>
                        </div>
                        {% else %}
                        {% for pedido in pedidos_ativos %}
                        <div class="p-5 rounded-2xl border border-stone-200 bg-stone-50/50 shadow-xs space-y-4">

                            <div class="flex justify-between items-start gap-2">
                                <div>
                                    <span class="font-black text-stone-800 text-base">Pedido #{{ pedido.id }}</span>
                                    <span class="text-stone-400 text-[10px] font-bold block">{{ pedido.criado_em
                                        }}</span>
                                </div>

                                <div>
                                    {% if pedido.status == 'Pendente' %}
                                    <span
                                        class="bg-amber-100 text-amber-800 border border-amber-200 text-xs font-extrabold px-2.5 py-1 rounded-lg">Pendente</span>
                                    {% elif pedido.status == 'Em preparo' %}
                                    <span
                                        class="bg-blue-100 text-blue-800 border border-blue-200 text-xs font-extrabold px-2.5 py-1 rounded-lg">Em
                                        preparo</span>
                                    {% elif pedido.status == 'Saiu para entrega' %}
                                    <span
                                        class="bg-purple-100 text-purple-800 border border-purple-200 text-xs font-extrabold px-2.5 py-1 rounded-lg">Saiu
                                        para Entrega</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="bg-white p-3.5 rounded-xl border border-stone-100 text-xs space-y-1.5">
                                <p class="font-bold text-stone-700">👤 Cliente: <span
                                        class="font-medium text-stone-600">{{ pedido.nome }}</span></p>
                                <p class="font-bold text-stone-700">📞 WhatsApp:
                                    <a href="https://wa.me/{{ pedido.telefone }}" target="_blank"
                                        class="text-blue-500 font-semibold hover:underline">
                                        {{ pedido.telefone }} ↗
                                    </a>
                                </p>
                                <p class="font-bold text-stone-700">📍 Bairro: <span
                                        class="font-medium text-stone-600">{{ pedido.bairro }} (Taxa: R$ {{
                                        "%.2f"|format(pedido.taxa_entrega)|replace('.', ',') }})</span></p>
                                <p class="font-bold text-stone-700">🏠 Endereço: <span
                                        class="font-medium text-stone-600">{{ pedido.endereco }}</span></p>
                            </div>

                            <div class="bg-white p-3.5 rounded-xl border border-stone-100 text-xs space-y-1.5">
                                <div
                                    class="flex justify-between font-bold text-stone-700 border-b border-stone-50 pb-1.5 mb-1.5">
                                    <span>Copão personalizado: {{ pedido.tamanho }}</span>
                                    <span class="text-divinoPink">Total: R$ {{ "%.2f"|format(pedido.total)|replace('.',
                                        ',') }}</span>
                                </div>
                                <p class="font-bold text-stone-700">🥣 Recheios:
                                    <span class="font-medium text-stone-600">{{ pedido.recheios|join(', ') }}</span>
                                </p>
                                {% if pedido.adicional_nutella > 0 %}
                                <p class="font-bold text-amber-700 flex items-center gap-1">
                                    <span>🍫 Adicional de Nutella:</span>
                                    <span
                                        class="bg-amber-100 text-amber-800 text-[9px] font-black px-1.5 py-0.5 rounded">R$
                                        3,00</span>
                                </p>
                                {% endif %}
                                <p class="font-bold text-stone-700">💵 Pagamento: <span
                                        class="font-semibold text-stone-600">{{ pedido.forma_pagamento }}</span></p>
                            </div>

                            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">

                                <div class="flex gap-2">

                                    <a href="/admin/pedidos/imprimir/{{ pedido.id }}" target="_blank"
                                        class="bg-stone-800 hover:bg-stone-900 text-white font-extrabold text-xs py-2.5 px-4 rounded-xl shadow-sm transition active:scale-95 text-center flex items-center gap-1.5 no-underline cursor-pointer">
                                        Imprimir Cupom 🖨️
                                    </a>

                                    {% if pedido.status == 'Pendente' %}
                                    <form action="/admin/pedidos/atualizar" method="POST">
                                        <input type="hidden" name="pedido_id" value="{{ pedido.id }}">
                                        <input type="hidden" name="novo_status" value="Em preparo">
                                        <button type="submit"
                                            class="bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-xs py-2.5 px-4 rounded-xl shadow-sm transition active:scale-95 cursor-pointer">
                                            Iniciar Preparo 👨‍🍳
                                        </button>
                                    </form>

                                    {% elif pedido.status == 'Em preparo' %}
                                    <form action="/admin/pedidos/atualizar" method="POST">
                                        <input type="hidden" name="pedido_id" value="{{ pedido.id }}">
                                        <input type="hidden" name="novo_status" value="Saiu para entrega">
                                        <button type="submit"
                                            class="bg-purple-600 hover:bg-purple-700 text-white font-extrabold text-xs py-2.5 px-4 rounded-xl shadow-sm transition active:scale-95 cursor-pointer">
                                            Saiu para Entrega 🛵
                                        </button>
                                    </form>

                                    {% elif pedido.status == 'Saiu para entrega' %}
                                    <form action="/admin/pedidos/atualizar" method="POST">
                                        <input type="hidden" name="pedido_id" value="{{ pedido.id }}">
                                        <input type="hidden" name="novo_status" value="Concluído">
                                        <button type="submit"
                                            class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs py-2.5 px-4 rounded-xl shadow-sm transition active:scale-95 cursor-pointer">
                                            Concluir Pedido ✅
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>

                                <form action="/admin/pedidos/atualizar" method="POST">
                                    <input type="hidden" name="pedido_id" value="{{ pedido.id }}">
                                    <input type="hidden" name="novo_status" value="Cancelado">
                                    <button type="submit"
                                        class="bg-stone-200 hover:bg-stone-300 text-stone-600 hover:text-stone-800 font-extrabold text-xs py-2.5 px-3 rounded-xl transition active:scale-95 cursor-pointer">
                                        Cancelar ❌
                                    </button>
                                </form>

                            </div>
                        </div>
                        {% endfor %}
                        {% endif %}
                    </div>
                </div>

            </div>

        </div>

        <p class="text-center text-[11px] text-stone-400 font-bold uppercase tracking-wider mt-12">
            Suporte técnico: João Gabriel Dev 🚀
        </p>

    </div>

    <script>
        // 1. ABRE O WHATSAPP EM NOVA ABA SE O STATUS MUDOU
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const linkWhats = urlParams.get('abrir_whats');

            if (linkWhats) {
                window.open(linkWhats, '_blank');
                window.history.replaceState({}, document.title, "/admin");
            }
        });

        function aplicarTaxaGlobal() {
            const valor = document.getElementById('taxa_promocional_input').value;
            if (!valor || parseFloat(valor) < 0) {
                alert('Por favor, digite um valor de taxa válido.');
                return;
            }

            // Criamos um form dinâmico para disparar o POST
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/taxas/promocao';

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'taxa_uniforme';
            input.value = valor;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function resetarTaxasPADRAO() {
            if (!confirm('Tem certeza que deseja voltar todas as taxas para o preço padrão original?')) {
                return;
            }
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/taxas/resetar';
            document.body.appendChild(form);
            form.submit();
        }

        // 2. ATUALIZAÇÃO AUTOMÁTICA DE PEDIDOS (POLLING DE 10 SEGUNDOS)
        let totalPedidosAtual = parseInt('{{ pedidos|rejectattr("status", "equalto", "Concluído")|rejectattr("status", "equalto", "Cancelado")|list|length }}') || 0;

        setInterval(async () => {
            try {
                const response = await fetch('/admin');
                if (response.ok) {
                    const htmlTexto = await response.text();
                    const parser = new DOMParser();
                    const docJson = parser.parseFromString(htmlTexto, 'text/html');
                    const contagemBadge = docJson.querySelector('.bg-pink-100.text-divinoPink');
                    if (contagemBadge) {
                        const totalNoServidor = parseInt(contagemBadge.textContent.trim());
                        if (totalNoServidor !== totalPedidosAtual) {
                            window.location.reload();
                        }
                    }
                }
            } catch (error) {
                console.error("Erro ao checar novos pedidos em background:", error);
            }
        }, 10000);
    </script>

</body>

</html>
</file>

<file path="templates/cardapio.html">
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doceria Divino Recheio - Cardápio de Pipoca Gourmet</title>
    <meta name="description"
        content="Peça os melhores potes de pipoca gourmet da Doceria Divino Recheio. Monte o seu personalizado com até 3 recheios e adicional de Nutella!">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght=300;400;500;700;800;900&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <style>
        body {
            font-family: 'Outfit', sans-serif !important;
        }
    </style>
</head>

<body class="bg-pink-50/50 text-gray-900 pb-40 relative">

    <div id="app">

        <header
            class="bg-pink-300 text-pink-700 p-6 rounded-b-[2.5rem] shadow-xl text-center border-b-4 border-pink-200 flex flex-col items-center gap-4">
            <input type="hidden" id="nutella_gratis_config" value="{{ 'true' if config.nutella_gratis else 'false' }}">
            <input type="hidden" id="whatsapp_vendedor_config" value="{{ config.whatsapp_vendedor }}">
            <input type="hidden" id="loja_aberta_config" value="{{ 'true' if config.loja_aberta else 'false' }}">

            <div
                class="relative w-36 h-36 bg-white rounded-full flex items-center justify-center p-1.5 shadow-2xl border-4 border-pink-200 shrink-0">
                <img src="/static/logo.png" alt="Logo Doceria Divino Recheio"
                    class="w-full h-full object-contain rounded-full">
            </div>
            <div>
                <h1 class="text-4xl font-black tracking-tight drop-shadow-md text-pink-700">Divino Recheio</h1>
                <p class="text-white font-extrabold text-xs mt-1 tracking-wider uppercase">Feito com amor, recheada de
                    sabor 💕</p>
            </div>
        </header>

        <main class="max-w-md mx-auto px-4 mt-6 space-y-6">

            <div class="bg-white p-6 rounded-3xl shadow-md border border-pink-100">
                <div class="flex items-center gap-3 mb-4 border-b border-pink-50 pb-2">
                    <span
                        class="bg-pink-300 text-pink-700 text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center shadow-sm">1</span>
                    <h3 class="font-extrabold text-lg text-pink-700">Escolha o Tamanho do Pote</h3>
                </div>

                <div class="space-y-3">
                    <label
                        class="flex justify-between items-center p-4 border-2 rounded-2xl cursor-pointer transition-all duration-200"
                        :class="tamanhoSelecionado === 22 ? 'border-pink-300 bg-pink-100/50 shadow-sm' : 'border-gray-100 bg-white'">
                        <div class="flex items-center gap-3">
                            <input type="radio" :value="22" v-model="tamanhoSelecionado"
                                class="w-5 h-5 accent-pink-300 scale-110">
                            <span class="font-bold text-gray-800">Pote 350ML</span>
                        </div>
                        <span class="font-black text-pink-300 text-lg">R$ 22,00</span>
                    </label>

                    <label
                        class="flex justify-between items-center p-4 border-2 rounded-2xl cursor-pointer transition-all duration-200"
                        :class="tamanhoSelecionado === 27 ? 'border-pink-300 bg-pink-100/50 shadow-sm' : 'border-gray-100 bg-white'">
                        <div class="flex items-center gap-3">
                            <input type="radio" :value="27" v-model="tamanhoSelecionado"
                                class="w-5 h-5 accent-pink-300 scale-110">
                            <span class="font-bold text-gray-800">Pote 500ML</span>
                        </div>
                        <span class="font-black text-pink-300 text-lg">R$ 27,00</span>
                    </label>

                    <label
                        class="flex justify-between items-center p-4 border-2 rounded-2xl cursor-pointer transition-all duration-200"
                        :class="tamanhoSelecionado === 37 ? 'border-pink-300 bg-pink-100/50 shadow-sm' : 'border-gray-100 bg-white'">
                        <div class="flex items-center gap-3">
                            <input type="radio" :value="37" v-model="tamanhoSelecionado"
                                class="w-5 h-5 accent-pink-300 scale-110">
                            <span class="font-bold text-gray-800">Pote 1L</span>
                        </div>
                        <span class="font-black text-pink-300 text-lg">R$ 37,00</span>
                    </label>
                </div>
            </div>

            <div class="bg-white p-6 rounded-3xl shadow-md border border-pink-100 transition-all duration-300"
                :class="!tamanhoSelecionado ? 'opacity-50 pointer-events-none select-none' : ''">

                <div class="flex items-center justify-between mb-4 border-b border-pink-50 pb-2">
                    <div class="flex items-center gap-3">
                        <span
                            class="bg-pink-300 text-pink-700 text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center shadow-sm">2</span>
                        <h3 class="font-extrabold text-lg text-pink-700">
                            Escolha até 3 Recheios
                            <span v-if="!tamanhoSelecionado"
                                class="text-xs font-normal text-pink-500 block mt-0.5">(Selecione o tamanho acima
                                primeiro)</span>
                        </h3>
                    </div>
                </div>

                <div class="space-y-2">
                    {% for nome, dados in ingredientes.items() %}
                    {% if dados.disponivel %}
                    <label
                        class="flex items-center justify-between p-3.5 border-2 rounded-xl cursor-pointer transition-all"
                        :class="recheiosSelecionados.includes('{{ nome }}') ? 'border-pink-300 bg-pink-100/40 shadow-xs' : 'border-gray-50 bg-white'">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" value="{{ nome }}" v-model="recheiosSelecionados"
                                @change="validarLimite" class="w-5 h-5 accent-pink-300 rounded">
                            <span class="text-gray-700 font-bold text-sm">
                                {{ nome }}
                                {% if nome == "Nutella" %}
                                <span
                                    class="text-[10px] text-white bg-amber-600 px-1.5 py-0.5 rounded-md ml-1 font-extrabold">Adicional</span>
                                {% endif %}
                            </span>
                        </div>
                        <span class="text-pink-400 text-xs">❤️</span>
                    </label>
                    {% endif %}
                    {% endfor %}
                </div>

                <div v-if="recheiosSelecionados.includes('Nutella') && tamanhoSelecionado !== 22"
                    class="mt-4 p-3 bg-amber-50 text-amber-900 rounded-xl text-xs font-bold border border-amber-200 shadow-inner">
                    ℹ️ Adicional de Nutella incluso para o tamanho: <strong>+ R$ <span
                            v-text="adicionalNutella.toFixed(2).replace('.', ',')"></span></strong>
                </div>
            </div>

            <div id="checkout" class="bg-white p-6 rounded-3xl shadow-md border border-pink-100 space-y-4 pt-10">
                <div class="flex items-center gap-3 border-b border-pink-50 pb-2">
                    <span
                        class="bg-pink-300 text-pink-700 text-xs font-bold w-6 h-6 rounded-full flex items-center justify-center shadow-sm">3</span>
                    <h3 class="font-extrabold text-lg text-pink-700">Finalizar Pedido</h3>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-black text-gray-500 uppercase tracking-wider">Nome Completo</label>
                    <input type="text" v-model="nomeCliente" placeholder="Como o entregador deve te chamar?"
                        class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold focus:outline-none focus:border-pink-300 transition-all">
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-black text-gray-500 uppercase tracking-wider">Telefone / WhatsApp</label>
                    <input type="tel" v-model="telefoneCliente" placeholder="Ex: (24) 99999-9999"
                        class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold focus:outline-none focus:border-pink-300 transition-all">
                </div>

                <div class="space-y-1.5 relative">
                    <label class="text-xs font-black text-gray-500 uppercase tracking-wider block">Bairro de
                        Entrega</label>

                    <button type="button" @click="toggleDropdownBairro"
                        class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold text-left focus:outline-none focus:border-pink-300 transition-all bg-white flex justify-between items-center select-none">
                        <span :class="bairroSelecionado ? 'text-gray-800' : 'text-gray-400'">
                            <span
                                v-text="bairroSelecionado ? bairroSelecionado + ' (R$ ' + taxaEntrega.toFixed(2).replace('.', ',') + ')' : 'Selecione seu bairro...'"></span>
                        </span>
                        <span class="text-xs text-gray-400">▼</span>
                    </button>

                    <div v-if="abrirDropdownBairro"
                        class="absolute left-0 right-0 z-[60] bg-white border-2 border-pink-100 rounded-2xl shadow-xl p-3 space-y-2 mt-1 max-h-60 overflow-y-auto">

                        <input type="text" v-model="buscaBairro" ref="inputBuscaBairro"
                            placeholder="Digite o nome do seu bairro..."
                            class="w-full p-2.5 border-2 border-pink-100 rounded-xl text-xs font-semibold focus:outline-none focus:border-pink-300 bg-pink-50/30">

                        <div class="space-y-1 pt-1">
                            {% for bairro, taxa in bairros.items() %}
                            <button type="button" v-show="filtrarBairro('{{ bairro }}')"
                                @click="clicarNoBairro('{{ bairro }}', {{ taxa }})"
                                class="w-full text-left p-2.5 hover:bg-pink-50 rounded-xl text-sm font-bold text-gray-700 transition-colors flex justify-between items-center">
                                <span>{{ bairro }}</span>
                                <span class="text-xs text-pink-500 bg-pink-100/50 px-2 py-0.5 rounded-md">R$ {{
                                    "%.2f"|format(taxa)|replace('.', ',') }}</span>
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <label class="text-xs font-black text-gray-500 uppercase tracking-wider">Rua /
                            Logradouro</label>
                        <input type="text" v-model="enderecoRua" placeholder="Ex: Av. Sete de Setembro, Rua das Flores"
                            class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold focus:outline-none focus:border-pink-300 transition-all">
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div class="col-span-1 space-y-1.5">
                            <label class="text-xs font-black text-gray-500 uppercase tracking-wider">Número</label>
                            <input type="text" v-model="enderecoNumero" placeholder="Ex: 123"
                                class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold focus:outline-none focus:border-pink-300 transition-all text-center">
                        </div>

                        <div class="col-span-2 space-y-1.5">
                            <label class="text-xs font-black text-gray-500 uppercase tracking-wider">Complemento <span
                                    class="text-gray-400 font-normal">(Opcional)</span></label>
                            <input type="text" v-model="enderecoComplemento" placeholder="Ex: Ap 202, Casa dos Fundos"
                                class="w-full p-3.5 border-2 border-gray-100 rounded-2xl text-sm font-semibold focus:outline-none focus:border-pink-300 transition-all">
                        </div>
                    </div>
                </div>

                <div class="space-y-2 pt-2">
                    <label class="text-xs font-black text-gray-500 uppercase tracking-wider block">Forma de
                        Pagamento</label>
                    <div class="grid grid-cols-2 gap-2">
                        <label
                            class="flex items-center gap-2.5 p-3 border rounded-xl cursor-pointer text-xs font-bold text-gray-700 select-none transition-all"
                            :class="formaPagamento === 'pix' ? 'border-pink-300 bg-pink-100/50 text-pink-700' : 'border-gray-100 bg-white'">
                            <input type="radio" value="pix" v-model="formaPagamento" class="accent-pink-300">
                            <span>Pix ⚡</span>
                        </label>

                        <label
                            class="flex items-center gap-2.5 p-3 border rounded-xl cursor-pointer text-xs font-bold text-gray-700 select-none transition-all"
                            :class="formaPagamento === 'credito' ? 'border-pink-300 bg-pink-100/50 text-pink-700' : 'border-gray-100 bg-white'">
                            <input type="radio" value="credito" v-model="formaPagamento" class="accent-pink-300">
                            <span>Crédito 💳</span>
                        </label>

                        <label
                            class="flex items-center gap-2.5 p-3 border rounded-xl cursor-pointer text-xs font-bold text-gray-700 select-none transition-all"
                            :class="formaPagamento === 'debito' ? 'border-pink-300 bg-pink-100/50 text-pink-700' : 'border-gray-100 bg-white'">
                            <input type="radio" value="debito" v-model="formaPagamento" class="accent-pink-300">
                            <span>Débito 💳</span>
                        </label>

                        <label
                            class="flex items-center gap-2.5 p-3 border rounded-xl cursor-pointer text-xs font-bold text-gray-700 select-none transition-all"
                            :class="formaPagamento === 'dinheiro' ? 'border-pink-300 bg-pink-100/50 text-pink-700' : 'border-gray-100 bg-white'">
                            <input type="radio" value="dinheiro" v-model="formaPagamento" class="accent-pink-300">
                            <span>Dinheiro 💵</span>
                        </label>
                    </div>
                </div>

                <div v-if="formaPagamento === 'dinheiro'"
                    class="bg-gray-50 p-3 rounded-xl border border-gray-200/60 space-y-2 mt-2 transition-all duration-200">
                    <span class="block text-[11px] font-black text-gray-500 uppercase tracking-wider">Precisa de
                        troco?</span>
                    <div class="grid grid-cols-2 gap-2">
                        <label
                            class="flex items-center justify-center gap-2 p-2 border rounded-lg bg-white cursor-pointer text-xs font-bold select-none"
                            :class="precisaTroco === 'nao' ? 'border-pink-300 bg-pink-50 text-pink-700' : 'border-gray-200 text-gray-600'">
                            <input type="radio" value="nao" v-model="precisaTroco" class="accent-pink-400">
                            Não preciso
                        </label>
                        <label
                            class="flex items-center justify-center gap-2 p-2 border rounded-lg bg-white cursor-pointer text-xs font-bold select-none"
                            :class="precisaTroco === 'sim' ? 'border-pink-300 bg-pink-50 text-pink-700' : 'border-gray-200 text-gray-600'">
                            <input type="radio" value="sim" v-model="precisaTroco" class="accent-pink-400">
                            Sim, preciso
                        </label>
                    </div>

                    <div v-if="precisaTroco === 'sim'" class="pt-1">
                        <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Troco para
                            quanto?</label>
                        <input type="text" v-model="valorTroco" placeholder="Ex: 50,00"
                            class="w-full p-2.5 border border-gray-200 rounded-lg text-xs font-bold focus:outline-pink-400 bg-white text-gray-700">
                    </div>
                </div>
            </div>
        </main>
        <div class="fixed bottom-0 left-0 right-0 border-t-4 p-4 z-50 rounded-t-4xl shadow-2xl transition-all duration-300"
            :class="lojaAbertaAtiva ? 'bg-pink-300 border-pink-200' : 'bg-stone-800 border-stone-700'">

            <div v-if="lojaAbertaAtiva" class="max-w-md mx-auto flex items-center justify-between gap-3">
                <div>
                    <p class="text-[10px] text-white/90 font-bold uppercase">Total (<span
                            v-text="itensNoCarrinho ? itensNoCarrinho.length : 0"></span> itens):</p>
                    <p class="text-2xl font-black text-pink-700 tracking-tight">R$ <span v-text="totalFormatado"></span>
                    </p>
                </div>
                <div class="flex-1 flex gap-1.5">
                    <button type="button" @click="adicionarAoCarrinho"
                        class="bg-pink-500 hover:bg-pink-600 text-white font-black py-3 px-3 rounded-xl transition-all text-xs border border-pink-600 shadow-sm active:scale-95 text-center">
                        🍿 + Adicionar
                    </button>
                    <button type="button" @click="irParaO_Carrinho"
                        class="bg-pink-100 text-pink-700 hover:bg-pink-200 font-black py-3 px-3 rounded-xl transition-all text-xs border border-pink-200 shadow-sm active:scale-95 text-center relative">
                        🛒 Carrinho
                        <span v-if="itensNoCarrinho.length > 0"
                            class="absolute -top-2 -right-2 bg-pink-600 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shadow"
                            v-text="itensNoCarrinho.length"></span>
                    </button>
                    <button type="button" @click="enviarPedido"
                        class="bg-white text-pink-700 hover:bg-pink-50 font-black py-3 px-3 rounded-xl transition-all text-xs shadow-md active:scale-95 text-center flex-1">
                        Finalizar 💬
                    </button>
                </div>
            </div>

            <div v-else class="max-w-md mx-auto text-center py-2">
                <p class="text-white font-black text-sm flex items-center justify-center gap-2">
                    <span>🛑</span> PEDIDOS ENCERRADOS POR HOJE!
                </p>
                <p class="text-stone-300 text-[11px] font-medium mt-0.5">
                    Já completamos nossa produção diária. Esperamos você no próximo expediente! 💕
                </p>
            </div>
        </div>

        <transition name="toast">
            <div v-if="toastMensagem"
                class="fixed top-5 left-1/2 z-[200] -translate-x-1/2 bg-gray-900/90 text-white text-xs font-bold px-5 py-3 rounded-2xl shadow-2xl backdrop-blur-sm max-w-xs text-center pointer-events-none"
                v-text="toastMensagem">
            </div>
        </transition>

        <transition name="fade">
            <div v-if="modalAdicionadoAberto"
                class="fixed inset-0 bg-black/50 z-[150] flex items-end justify-center p-4 pb-6">
                <transition name="slide-up">
                    <div v-if="modalAdicionadoAberto"
                        class="bg-white rounded-3xl shadow-2xl border border-pink-100 w-full max-w-sm overflow-hidden">

                        <div class="bg-gradient-to-r from-pink-400 to-pink-300 p-5 text-center">
                            <div class="text-4xl mb-1">🍿✅</div>
                            <h3 class="font-black text-white text-lg drop-shadow">Adicionado ao Carrinho!</h3>
                            <p class="text-pink-100 text-xs font-semibold mt-0.5">Seu pote foi reservado com sucesso</p>
                        </div>

                        <div v-if="ultimoItemAdicionado" class="px-5 py-4 space-y-2">
                            <div class="bg-pink-50 rounded-2xl p-3.5 border border-pink-100 space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <span class="text-xs font-black text-pink-700 uppercase tracking-wide">Pote</span>
                                    <span class="text-xs font-black text-pink-600 bg-pink-100 px-2 py-0.5 rounded-lg"
                                        v-text="ultimoItemAdicionado.tamanhoLabel"></span>
                                </div>
                                <div class="flex justify-between items-start">
                                    <span class="text-xs font-semibold text-gray-500">Recheios</span>
                                    <span class="text-xs font-bold text-gray-800 text-right max-w-[180px]"
                                        v-text="ultimoItemAdicionado.recheios.join(', ')"></span>
                                </div>
                                <div class="flex justify-between items-center border-t border-pink-100 pt-1.5 mt-1">
                                    <span class="text-xs font-black text-gray-600">Valor</span>
