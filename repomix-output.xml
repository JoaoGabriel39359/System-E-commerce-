                        nosso WhatsApp.
                    </p>
                    <div class="pt-2">
                        <button type="button" @click="irParaLinkWhatsApp"
                            class="w-full bg-pink-300 text-pink-700 hover:bg-pink-200 font-black py-4 px-4 rounded-2xl transition-all text-sm shadow-md active:scale-95">
                            Abrir Conversa no WhatsApp 💬
                        </button>
                    </div>
                </div>
            </div>
        </transition>
    </div>
    <script src="/static/js/app-cliente.js"></script>

    <style>
        .fade-enter-active,
        .fade-leave-active {
            transition: opacity 0.3s;
        }

        .fade-enter-from,
        .fade-leave-to {
            opacity: 0;
        }

        .fade-enter-active .transform,
        .fade-leave-active .transform {
            transition: transform 0.3s;
        }

        .fade-enter-from .transform {
            transform: scale(0.9);
        }

        .fade-leave-to .transform {
            transform: scale(0.9);
        }

        /* Toast de aviso */
        .toast-enter-active {
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .toast-leave-active {
            transition: all 0.25s ease-in;
        }

        .toast-enter-from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }

        .toast-leave-to {
            opacity: 0;
            transform: translateY(-10px) scale(0.95);
        }

        /* Modal de confirmação - slide up */
        .slide-up-enter-active {
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .slide-up-leave-active {
            transition: all 0.25s ease-in;
        }

        .slide-up-enter-from {
            opacity: 0;
            transform: translateY(40px) scale(0.96);
        }

        .slide-up-leave-to {
            opacity: 0;
            transform: translateY(20px) scale(0.96);
        }
    </style>
</body>

